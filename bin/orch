#!/usr/bin/env bash
# orch — Launch Claude Orchestrator (native Swift app)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$SCRIPT_DIR/.."
APP_DIR="$REPO_DIR/app-native"

# Parse arguments — separate flags from project path
ARGS=()
PROJECT_PATH=""
for arg in "$@"; do
  case "$arg" in
    -c|--continue|-h|--help)
      ARGS+=("$arg")
      ;;
    -r|--resume)
      ARGS+=("$arg")
      ;;
    -*)
      ARGS+=("$arg")
      ;;
    *)
      # If previous arg was --resume/-r, this is the session ID
      if [[ ${#ARGS[@]} -gt 0 && ( "${ARGS[-1]}" == "-r" || "${ARGS[-1]}" == "--resume" ) ]]; then
        ARGS+=("$arg")
      elif [ -z "$PROJECT_PATH" ]; then
        PROJECT_PATH="$arg"
      else
        ARGS+=("$arg")
      fi
      ;;
  esac
done

# Default to current directory if no project path given
PROJECT_PATH="${PROJECT_PATH:-$(pwd)}"

# Resolve to absolute path
PROJECT_PATH="$(cd "$PROJECT_PATH" && pwd)"

# Ensure .orch dir exists
mkdir -p "$PROJECT_PATH/.orch"

# Load .env files safely (handles values with special chars)
load_env() {
  local file="$1"
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    # Skip comments and blank lines
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// }" ]] && continue
    # Extract KEY=VALUE, export with quoting to handle special chars
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*) ]]; then
      export "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
    fi
  done < "$file"
}

# Optional local credential hook. If you'd rather keep API keys in a secret
# manager than in a .env file, drop a script here that exports them (see
# docs/project-config.md). Sourced before the project .env so a project can
# still override. Absent by default — .env alone is a fine setup.
[ -f "$HOME/.config/orch/load-linear-env.sh" ] && . "$HOME/.config/orch/load-linear-env.sh"

load_env "$PROJECT_PATH/.env"
load_env "$REPO_DIR/.env"

# Build native app if needed
BINARY="$APP_DIR/.build/debug/orch"
if [ ! -f "$BINARY" ]; then
  echo "Building native app..."
  (cd "$APP_DIR" && swift build 2>&1)
fi

# Check if source is newer than binary
NEWEST_SRC=$(find "$APP_DIR/Sources" -name '*.swift' -newer "$BINARY" 2>/dev/null | head -1)
if [ -n "$NEWEST_SRC" ]; then
  echo "Rebuilding..."
  (cd "$APP_DIR" && swift build 2>&1)
fi

# --- Create a temporary .app bundle so macOS shows the project name in the dock ---
PROJECT_NAME="$(basename "$PROJECT_PATH")"
APP_BUNDLE="$PROJECT_PATH/.orch/$PROJECT_NAME.app"
BUNDLE_MACOS="$APP_BUNDLE/Contents/MacOS"

mkdir -p "$BUNDLE_MACOS"

# Copy the real binary into the bundle (not a symlink — codesign requires a regular file
# so TCC can record a stable designated requirement for Camera/Mic permissions).
#
# Test -L first: `-ef` compares device+inode *after* resolving symlinks, so a
# legacy bundle whose executable is a symlink to $BINARY compares equal and the
# copy gets skipped forever. Such bundles can never be signed ("the main
# executable or Info.plist must be a regular file"), so they keep whatever stale
# signature they had, TCC can't record a grant against them, and every launch
# re-prompts. Replacing the symlink with a real copy is what makes them signable.
if [ -L "$BUNDLE_MACOS/orch" ] || [ ! "$BINARY" -ef "$BUNDLE_MACOS/orch" ]; then
  rm -f "$BUNDLE_MACOS/orch"
  cp -f "$BINARY" "$BUNDLE_MACOS/orch"
fi

# Write Info.plist with the project name as the display name
cat > "$APP_BUNDLE/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>orch</string>
  <key>CFBundleName</key>
  <string>$PROJECT_NAME</string>
  <key>CFBundleDisplayName</key>
  <string>$PROJECT_NAME</string>
  <key>CFBundleIdentifier</key>
  <string>com.orch.$PROJECT_NAME</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>LSUIElement</key>
  <false/>
  <key>NSCameraUsageDescription</key>
  <string>$PROJECT_NAME uses the camera for computer-vision work performed by Claude Code sessions.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>$PROJECT_NAME may access the microphone for projects that involve audio capture.</string>
</dict>
</plist>
PLIST

# Sign the bundle so TCC can prompt and remember permissions
# (NSCameraUsageDescription has no effect on unsigned Mach-O binaries).
#
# Sign with a real identity, not ad-hoc. An ad-hoc signature gives TCC no
# certificate to key the grant against, so it falls back to recording the
# cdhash — which changes on every rebuild, silently discarding every
# permission you granted and re-prompting. With an identity the designated
# requirement is (bundle id + certificate leaf), which survives rebuilds.
#
# Override with ORCH_SIGN_ID; otherwise use the first codesigning identity in
# the keychain. Falls back to ad-hoc if none is available (prompts will recur).
if [ -z "${ORCH_SIGN_ID:-}" ]; then
  # `|| true` matters: under `set -euo pipefail` a failing lookup would abort
  # the script instead of falling through to the ad-hoc path below.
  ORCH_SIGN_ID=$(security find-identity -v -p codesigning 2>/dev/null \
    | awk '/^[[:space:]]*1\)/ {print $2; exit}' || true)
fi

if [ -n "${ORCH_SIGN_ID:-}" ]; then
  SIGN_TARGET="$ORCH_SIGN_ID"
else
  echo "orch: no codesigning identity found; falling back to ad-hoc signing." >&2
  echo "      macOS will re-ask for permissions after every rebuild." >&2
  SIGN_TARGET="-"
fi

# Don't silence codesign. A failure here leaves the bundle with a stale or
# missing signature, which makes macOS re-prompt for permissions on every
# single launch — the failure needs to be visible, not swallowed.
if ! SIGN_ERR=$(codesign --force --sign "$SIGN_TARGET" "$APP_BUNDLE" 2>&1); then
  echo "orch: codesign failed — macOS will re-ask for permissions every launch." >&2
  echo "      $SIGN_ERR" >&2
fi

# Launch via open so macOS registers the bundle name for the dock
LOGFILE="$PROJECT_PATH/.orch/orch.log"
open -n "$APP_BUNDLE" --args "$PROJECT_PATH" ${ARGS[@]+"${ARGS[@]}"} 2>"$LOGFILE" &
disown
