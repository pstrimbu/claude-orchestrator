#!/usr/bin/env bash
# orch — Create or attach to the project's orchestrator session
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'HELP'
orch — Claude Code orchestrator

Usage: orch [--help]

Commands (all default worker name to "main"):
  orch                  Create or reattach to orchestrator session
  orch-create [name]    Create a worker pane
  orch-destroy [name] --summary "desc"  Shut down worker (summary required)
  orch-send [name] <msg>         Send short message to worker
  orch-send-task [name] <desc>   Send complex task via file
  orch-read [name] [lines]       Read worker output (default 50)
  orch-health [name]             Check worker health
  orch-list                      List all workers with status
  orch-timer start|stop|status    Manage activity timer daemon
  orch-flush                     Flush accumulated time to Clockify
  orch-pause [name|--all]        Pause worker(s)
  orch-reload                    Reload orchestrator config

tmux keybindings:
  Ctrl-b d    Detach (session keeps running)
  Ctrl-b h    Show this help (popup)
  Ctrl-b p    Pause all workers
  Ctrl-b P    Pause focused pane
  Ctrl-b r    Reload orchestrator config (re-read init-prompt.md)
  Ctrl-b t    Flush accumulated time to Clockify
  Mouse drag  Select and copy to clipboard
HELP
    exit 0
fi

source "$(dirname "$0")/orch-lib.sh"

# Clean up stale tmux server from old naming convention
if ! orch_session_exists && [[ -S "$ORCH_TMUX_SOCK" ]]; then
    "$ORCH_HOME/bin/orch-timer" stop 2>/dev/null || true
    if orch_tmux list-sessions >/dev/null 2>&1; then
        echo "cleaning up stale tmux server (session name mismatch)..."
        orch_tmux kill-server 2>/dev/null || true
    fi
    rm -f "$ORCH_TMUX_SOCK"
    rm -rf "$(orch_pane_dir)"
    rm -rf "${ORCH_STATE_DIR:-.orch}/clockify"
fi

if orch_session_exists; then
    workdir="$(pwd -P)"
    orch_tmux set-option -t "$ORCH_SESSION" set-titles on 2>/dev/null || true
    orch_tmux set-option -t "$ORCH_SESSION" set-titles-string "$ORCH_PROJECT_ID" 2>/dev/null || true
    # Prevent flashing on attach from different terminal sizes
    orch_tmux set-option -t "$ORCH_SESSION" window-size latest 2>/dev/null || true
    orch_tmux set-window-option -t "$ORCH_SESSION" aggressive-resize on 2>/dev/null || true
    # Ensure detach hook is set (picks up new feature on existing sessions)
    orch_tmux set-hook -t "$ORCH_SESSION" client-detached "run-shell \"cd $workdir && $ORCH_HOME/bin/orch-flush --reason detach\"" 2>/dev/null || true
    # Ensure timer daemon is running
    "$ORCH_HOME/bin/orch-timer" start 2>/dev/null || true
    echo "attaching to $ORCH_SESSION"
    TMUX= orch_tmux attach -t "$ORCH_SESSION"
else
    workdir="$(pwd -P)"

    mkdir -p "$(dirname "$ORCH_TMUX_SOCK")"
    # Use actual terminal dimensions to avoid tmux dot-fill on attach
    cols="$(tput cols 2>/dev/null || echo 200)"
    rows="$(tput lines 2>/dev/null || echo 50)"
    # Sanity check: reject absurd dimensions (e.g. tput returns 1 from a tiny pane)
    (( cols < 80 )) && cols=200
    (( rows < 24 )) && rows=50
    orch_tmux new-session -d -s "$ORCH_SESSION" -c "$workdir" -x "$cols" -y "$rows"
    orch_tmux rename-window -t "$ORCH_SESSION" "$ORCH_PROJECT_ID"
    orch_tmux set-option -t "$ORCH_SESSION" set-titles on
    orch_tmux set-option -t "$ORCH_SESSION" set-titles-string "$ORCH_PROJECT_ID"
    orch_tmux set-option -t "$ORCH_SESSION" mouse on
    orch_tmux set-option -t "$ORCH_SESSION" set-clipboard on
    orch_tmux set-option -t "$ORCH_SESSION" history-limit 50000
    # Size windows to the most-recently-active client instead of the smallest
    # — prevents flashing/redraw loops when attaching from different terminal sizes
    orch_tmux set-option -t "$ORCH_SESSION" window-size latest
    orch_tmux set-window-option -t "$ORCH_SESSION" aggressive-resize on
    orch_tmux set-option -t "$ORCH_SESSION" pane-border-status top
    orch_tmux set-option -t "$ORCH_SESSION" pane-border-format '#{pane_index}: #{pane_title}'
    orch_tmux set-window-option -t "$ORCH_SESSION" main-pane-width 50% 2>/dev/null || true

    # Copy mode: mouse drag selects and copies to system clipboard
    orch_tmux bind-key -T copy-mode MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
    orch_tmux bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"

    # Keybindings: Ctrl-b p = pause all, P = pause focused, r = reload config, h = help
    orch_tmux bind-key -T prefix p run-shell "$ORCH_HOME/bin/orch-pause --all"
    orch_tmux bind-key -T prefix P send-keys Escape
    orch_tmux bind-key -T prefix r run-shell "$ORCH_HOME/bin/orch-reload"
    orch_tmux bind-key -T prefix h display-popup -w 70 -h 30 "$ORCH_HOME/bin/orch --help"
    orch_tmux bind-key -T prefix t run-shell "$ORCH_HOME/bin/orch-flush --reason manual"

    # Flush time on detach (Ctrl-b d)
    orch_tmux set-hook -t "$ORCH_SESSION" client-detached "run-shell \"cd $workdir && $ORCH_HOME/bin/orch-flush --reason detach\""

    # Start activity timer daemon
    "$ORCH_HOME/bin/orch-timer" start 2>/dev/null || true

    orch_tmux send-keys -t "$ORCH_SESSION" "claude --dangerously-skip-permissions" Enter

    # Wait for claude to start
    echo "starting orchestrator for $ORCH_PROJECT_ID..."
    sleep 5

    # Prime the orchestrator
    msg="$(orch_build_boot_msg orchestrator)"
    orch_tmux send-keys -l -t "$ORCH_SESSION" -- "$msg"
    sleep 0.3
    orch_tmux send-keys -t "$ORCH_SESSION" Enter
    sleep 3

    # Log
    state_dir="$(orch_state_dir)"
    echo "{\"session\":\"$ORCH_SESSION\",\"workdir\":\"$workdir\",\"created\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"role\":\"orchestrator\"}" >> "$state_dir/workers.jsonl"

    echo "created $ORCH_SESSION — attaching"
    TMUX= orch_tmux attach -t "$ORCH_SESSION"
fi
