#!/usr/bin/env bash
# orch — Create or attach to the project's orchestrator session
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

# Clean up stale tmux server from old naming convention
if ! orch_session_exists && [[ -S "$ORCH_TMUX_SOCK" ]]; then
    if orch_tmux list-sessions >/dev/null 2>&1; then
        echo "cleaning up stale tmux server (session name mismatch)..."
        orch_tmux kill-server 2>/dev/null || true
    fi
    rm -f "$ORCH_TMUX_SOCK"
    rm -rf "$(orch_pane_dir)"
fi

if orch_session_exists; then
    orch_tmux set-option -t "$ORCH_SESSION" set-titles on 2>/dev/null || true
    orch_tmux set-option -t "$ORCH_SESSION" set-titles-string "$ORCH_PROJECT_ID" 2>/dev/null || true
    echo "attaching to $ORCH_SESSION"
    TMUX= orch_tmux attach -t "$ORCH_SESSION"
else
    workdir="$(pwd -P)"

    mkdir -p "$(dirname "$ORCH_TMUX_SOCK")"
    orch_tmux new-session -d -s "$ORCH_SESSION" -c "$workdir"
    orch_tmux rename-window -t "$ORCH_SESSION" "$ORCH_PROJECT_ID"
    orch_tmux set-option -t "$ORCH_SESSION" set-titles on
    orch_tmux set-option -t "$ORCH_SESSION" set-titles-string "$ORCH_PROJECT_ID"
    orch_tmux set-option -t "$ORCH_SESSION" mouse on
    orch_tmux set-option -t "$ORCH_SESSION" history-limit 50000
    orch_tmux set-option -t "$ORCH_SESSION" pane-border-status top
    orch_tmux set-option -t "$ORCH_SESSION" pane-border-format '#{pane_index}: #{pane_title}'
    orch_tmux set-window-option -t "$ORCH_SESSION" main-pane-width 50% 2>/dev/null || true

    # Keybindings: Ctrl-b p = pause all workers, Ctrl-b P = pause focused pane
    orch_tmux bind-key -T prefix p run-shell "$ORCH_HOME/bin/orch-pause --all"
    orch_tmux bind-key -T prefix P send-keys Escape
    orch_tmux send-keys -t "$ORCH_SESSION" "claude --dangerously-skip-permissions" Enter

    # Wait for claude to start
    echo "starting orchestrator for $ORCH_PROJECT_ID..."
    sleep 5

    # Prime the orchestrator
    msg="$(orch_build_boot_msg orchestrator)"
    orch_tmux send-keys -l -t "$ORCH_SESSION" -- "$msg"
    sleep 0.3
    orch_tmux send-keys -t "$ORCH_SESSION" Enter
    sleep 3

    # Log
    state_dir="$(orch_state_dir)"
    echo "{\"session\":\"$ORCH_SESSION\",\"workdir\":\"$workdir\",\"created\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"role\":\"orchestrator\"}" >> "$state_dir/workers.jsonl"

    echo "created $ORCH_SESSION — attaching"
    TMUX= orch_tmux attach -t "$ORCH_SESSION"
fi
