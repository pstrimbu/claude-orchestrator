#!/usr/bin/env bash
# orch-send — Send a short message to a worker
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

name="$(orch_resolve_name "${1:-}")"
orch_validate_name "$name"
shift

message="$*"
if [[ -z "$message" ]]; then
    orch_die "message is required"
fi

if ! orch_session_exists "$name"; then
    orch_die "session $(orch_session_name "$name") does not exist"
fi

if [[ "$message" == *$'\n'* ]]; then
    orch_die "message contains newlines — use orch-send-task instead"
fi

if [[ ${#message} -gt 1000 ]]; then
    echo "warning: message is ${#message} chars — consider orch-send-task for long messages" >&2
fi

session="$(orch_session_name "$name")"
orch_tmux send-keys -l -t "$session" -- "$message"
sleep 0.3
orch_tmux send-keys -t "$session" Enter

echo "sent to $session"
