#!/usr/bin/env bash
# orch-destroy — Shut down a worker pane
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

# Parse arguments: orch-destroy [name] [--summary "desc"] [--force]
name=""
summary=""
force=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --summary)
            shift
            summary="${1:-}"
            [[ -z "$summary" ]] && orch_die "--summary requires a value"
            shift
            ;;
        --force)
            force=true
            shift
            ;;
        -*)
            orch_die "unknown option: $1"
            ;;
        *)
            if [[ -z "$name" ]]; then
                name="$1"
            else
                orch_die "unexpected argument: $1"
            fi
            shift
            ;;
    esac
done

name="$(orch_resolve_name "$name")"
orch_validate_name "$name"

# Require --summary or --force
if [[ -z "$summary" ]] && [[ "$force" != true ]]; then
    orch_die "orch-destroy requires --summary \"60-120 char description\" (or --force to skip)"
fi

# Validate summary length
if [[ -n "$summary" ]]; then
    len=${#summary}
    if (( len < 60 )); then
        orch_die "summary too short ($len chars) — minimum 60 characters"
    fi
    if (( len > 120 )); then
        orch_die "summary too long ($len chars) — maximum 120 characters"
    fi
fi

pane_id="$(orch_worker_pane "$name")"
if [[ -z "$pane_id" ]]; then
    orch_die "worker '$name' does not exist"
fi

# Save final output if pane is alive
if ! orch_worker_exists "$name"; then
    echo "worker '$name' pane is stale — cleaning up" >&2
fi
if orch_worker_exists "$name"; then
    task_dir="$(orch_task_dir)"
    timestamp="$(date +%Y%m%d-%H%M%S)"
    orch_tmux capture-pane -t "$pane_id" -p -S -200 -J > "$task_dir/${name}-final-${timestamp}.log" 2>/dev/null || true

    # Graceful exit
    orch_tmux send-keys -l -t "$pane_id" -- "/exit"
    sleep 0.3
    orch_tmux send-keys -t "$pane_id" Enter

    # Wait up to 5 seconds for claude to exit
    for i in $(seq 1 10); do
        if ! orch_claude_running "$name" 2>/dev/null; then
            break
        fi
        sleep 0.5
    done

    # Kill the pane
    orch_tmux kill-pane -t "$pane_id" 2>/dev/null || true
fi

# Log task event for activity timer
if [[ -n "$summary" ]]; then
    orch_log_task "DESTROY" "$summary"
fi

# Clean up pane file
rm -f "$(orch_pane_dir)/$name"

# Re-layout remaining panes
orch_relayout

# Log
state_dir="$(orch_state_dir)"
echo "{\"name\":\"$name\",\"pane\":\"$pane_id\",\"destroyed\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"status\":\"destroyed\"}" >> "$state_dir/workers.jsonl"

echo "destroyed worker '$name'"
