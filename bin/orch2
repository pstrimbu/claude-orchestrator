#!/usr/bin/env bash
# orch2 — Launch Claude Orchestrator v2 (web UI)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
V2_DIR="$SCRIPT_DIR/../v2"
PROJECT_PATH="${1:-$(pwd)}"

# Resolve to absolute path
PROJECT_PATH="$(cd "$PROJECT_PATH" && pwd)"

# Ensure .orch dir exists
mkdir -p "$PROJECT_PATH/.orch"

API_PORT="${ORCH_PORT:-5970}"
UI_PORT=3270

echo "Claude Orchestrator v2"
echo "Project: $(basename "$PROJECT_PATH")"
echo "Path: $PROJECT_PATH"
echo ""

# Check if dependencies are installed
if [ ! -d "$V2_DIR/node_modules" ]; then
  echo "Installing dependencies..."
  (cd "$V2_DIR" && npm install)
fi

# Check if shared types are built
if [ ! -d "$V2_DIR/packages/shared/dist" ]; then
  echo "Building shared types..."
  (cd "$V2_DIR" && npm run build:shared)
fi

# Cleanup on exit
cleanup() {
  echo ""
  echo "Shutting down..."
  kill $SERVER_PID 2>/dev/null || true
  [ -n "${CLIENT_PID:-}" ] && kill "$CLIENT_PID" 2>/dev/null || true
  wait 2>/dev/null
}
trap cleanup EXIT INT TERM

# Check if production client build exists
CLIENT_DIST="$V2_DIR/packages/client/dist"

if [ -d "$CLIENT_DIST" ] && [ -f "$CLIENT_DIST/index.html" ]; then
  # Production mode — server serves static files directly
  echo "Production mode (serving built client)"
  echo "Starting on port $API_PORT..."
  npx --prefix "$V2_DIR" tsx "$V2_DIR/packages/server/src/index.ts" "$PROJECT_PATH" &
  SERVER_PID=$!
  sleep 2

  if command -v open &>/dev/null; then
    open "http://localhost:$API_PORT"
  elif command -v xdg-open &>/dev/null; then
    xdg-open "http://localhost:$API_PORT"
  fi

  echo "URL: http://localhost:$API_PORT"
  echo "Press Ctrl+C to stop"
else
  # Dev mode — separate API server + Vite dev server
  echo "Dev mode"

  echo "Starting API server on port $API_PORT..."
  npx --prefix "$V2_DIR" tsx "$V2_DIR/packages/server/src/index.ts" "$PROJECT_PATH" &
  SERVER_PID=$!

  echo "Starting UI dev server on port $UI_PORT..."
  (cd "$V2_DIR/packages/client" && npx vite --port "$UI_PORT") &
  CLIENT_PID=$!

  sleep 2

  if command -v open &>/dev/null; then
    open "http://localhost:$UI_PORT"
  elif command -v xdg-open &>/dev/null; then
    xdg-open "http://localhost:$UI_PORT"
  fi

  echo ""
  echo "API: http://localhost:$API_PORT"
  echo "UI:  http://localhost:$UI_PORT"
  echo "Press Ctrl+C to stop"
fi

wait
