#!/usr/bin/env bash
# orch-clock — Track orchestrator active time via Clockify
# Usage: orch-clock start "Brief description of current work"
#        orch-clock stop
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

action="${1:-}"
if [[ -z "$action" ]]; then
    orch_die "usage: orch-clock start \"description\" | orch-clock stop"
fi

clockify_dir="$(orch_clockify_dir)"

case "$action" in
    start)
        description="${2:-}"
        if [[ -z "$description" ]]; then
            orch_die "usage: orch-clock start \"description of current work\""
        fi

        # Auto-stop existing timer to prevent leaks
        if [[ -f "$clockify_dir/orchestrator" ]]; then
            echo "auto-stopping previous orchestrator timer..."
            prev_desc=""
            if [[ -f "$clockify_dir/orchestrator.desc" ]]; then
                prev_desc="$(cat "$clockify_dir/orchestrator.desc")"
            fi
            orch_clockify_stop "orchestrator" "${prev_desc:-orchestrator session (auto-stopped)}" || true
        fi

        # Save description for stop
        echo "$description" > "$clockify_dir/orchestrator.desc"

        # Start timer
        orch_clockify_start "orchestrator" "$description" || true
        ;;

    stop)
        if [[ ! -f "$clockify_dir/orchestrator" ]]; then
            echo "no orchestrator timer running"
            exit 0
        fi

        description=""
        if [[ -f "$clockify_dir/orchestrator.desc" ]]; then
            description="$(cat "$clockify_dir/orchestrator.desc")"
        fi

        orch_clockify_stop "orchestrator" "${description:-orchestrator session}" || true
        rm -f "$clockify_dir/orchestrator.desc"
        ;;

    *)
        orch_die "unknown action '$action' — use 'start' or 'stop'"
        ;;
esac
