#!/usr/bin/env bash
# orch-linear-refresh — force an immediate refresh of the cached Linear API keys
# from AWS Secrets Manager, bypassing the loader's TTL. Run after rotating a key.
#
# Keys never printed; only lengths are shown for confirmation.

LOADER="$HOME/.config/orch/load-linear-env.sh"
CACHE="${ORCH_LINEAR_CACHE:-$HOME/.config/orch/linear.env}"

if [ ! -f "$LOADER" ]; then
  echo "orch-linear-refresh: loader not found: $LOADER" >&2
  exit 1
fi

# Drop the cache so the loader is forced to fetch fresh values.
rm -f "$CACHE"

# shellcheck disable=SC1090
source "$LOADER"

if [ ! -f "$CACHE" ] || [ -z "${LINEAR_API_KEY:-}" ]; then
  echo "orch-linear-refresh: FAILED to fetch keys via the loader." >&2
  echo "  Check that $LOADER can reach your secret store" >&2
  echo "  (e.g. valid AWS credentials, if it reads Secrets Manager)." >&2
  exit 1
fi

echo "Refreshed Linear keys -> $CACHE"
# Report every LINEAR_API_KEY* the loader exported; keys are never printed,
# only their lengths. Workspaces vary per user, so nothing is assumed here.
for var in $(compgen -v | grep -E '^LINEAR_API_KEY' | sort); do
  val="${!var:-}"
  [ -n "$val" ] && printf '  %-20s (%d chars)\n' "$var" "${#val}"
done
echo "New orch sessions and shells pick this up automatically."
echo "For your *current* shell: source \"$LOADER\""
