#!/usr/bin/env bash
# orch-list — List all workers with status
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

sessions="$(orch_tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^${SESSION_PREFIX}" || true)"

if [[ -z "$sessions" ]]; then
    exit 0
fi

while IFS= read -r session; do
    name="${session#"$SESSION_PREFIX"}"
    session_ok="yes"
    claude_ok="no"
    if orch_claude_running "$name"; then
        claude_ok="yes"
    fi
    echo "$session  session=$session_ok claude=$claude_ok"
done <<< "$sessions"
