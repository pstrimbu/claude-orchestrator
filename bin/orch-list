#!/usr/bin/env bash
# orch-list — List all workers with status
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

pane_dir="$(orch_pane_dir)"

for pane_file in "$pane_dir"/*; do
    [[ -f "$pane_file" ]] || continue
    name="$(basename "$pane_file")"
    if orch_worker_exists "$name"; then
        claude_ok="no"
        stuck="no"
        if orch_claude_running "$name"; then
            claude_ok="yes"
        fi
        pane_id="$(cat "$pane_file")"
        if orch_pane_stuck "$pane_id"; then
            stuck="yes"
        fi
        echo "$name  pane=yes claude=$claude_ok stuck=$stuck"
    else
        # Auto-prune stale pane files
        rm -f "$pane_file"
        echo "$name  (stale — pruned)"
    fi
done

echo ""
"$ORCH_HOME/bin/orch-timer" status 2>/dev/null || echo "timer: not running"
"$ORCH_HOME/bin/orch-watchdog" status 2>/dev/null || echo "watchdog: not running"
