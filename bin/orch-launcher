#!/usr/bin/env bash
# orch-launcher — Launch the orch project launcher UI (native Swift)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LAUNCHER_DIR="$SCRIPT_DIR/../launcher-native"
BINARY="$LAUNCHER_DIR/orch-launcher"

# Source orchestrator's .env for shared credentials
if [ -f "$SCRIPT_DIR/../.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// }" ]] && continue
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*) ]]; then
      export "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
    fi
  done < "$SCRIPT_DIR/../.env"
fi

# Build if needed
needs_build=false
if [ ! -f "$BINARY" ]; then
  needs_build=true
else
  # Rebuild if any Swift source is newer than the binary
  while IFS= read -r src; do
    if [ "$src" -nt "$BINARY" ]; then
      needs_build=true
      break
    fi
  done < <(find "$LAUNCHER_DIR/Sources" -name '*.swift')
fi

if [ "$needs_build" = true ]; then
  echo "Building launcher..."
  (cd "$LAUNCHER_DIR" && swift build -c release 2>&1)
  cp "$LAUNCHER_DIR/.build/release/orch-launcher" "$BINARY"
fi

exec "$BINARY"
