#!/usr/bin/env bash
# orch-launcher — Launch the orch3 project launcher UI (Tauri)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LAUNCHER_DIR="$SCRIPT_DIR/../launcher"
BINARY="$LAUNCHER_DIR/src-tauri/target/release/orch3-launcher"

# Source orchestrator's .env for shared credentials
if [ -f "$SCRIPT_DIR/../.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// }" ]] && continue
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*) ]]; then
      export "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
    fi
  done < "$SCRIPT_DIR/../.env"
fi

# Build if needed
if [ ! -f "$BINARY" ] || \
   [ "$LAUNCHER_DIR/src-tauri/src/lib.rs" -nt "$BINARY" ] || \
   [ "$LAUNCHER_DIR/src/main.ts" -nt "$BINARY" ]; then
  echo "Building launcher..."
  (cd "$LAUNCHER_DIR" && npx tauri build 2>&1)
fi

exec "$BINARY"
