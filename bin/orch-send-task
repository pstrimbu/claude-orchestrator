#!/usr/bin/env bash
# orch-send-task — Send a complex task to a worker via file
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

name="$(orch_resolve_name "${1:-}")"
orch_validate_name "$name"
shift

if ! orch_worker_exists "$name"; then
    orch_die "worker '$name' does not exist"
fi

task_dir="$(orch_task_dir)"
timestamp="$(date +%Y%m%d-%H%M%S)"
task_file="$task_dir/${name}-${timestamp}.md"

if [[ "${1:-}" == "--file" ]]; then
    src="${2:-}"
    if [[ -z "$src" || ! -f "$src" ]]; then
        orch_die "file not found: ${src:-<none>}"
    fi
    cp "$src" "$task_file"
else
    description="$*"
    if [[ -z "$description" ]]; then
        orch_die "task description or --file <path> is required"
    fi
    echo "$description" > "$task_file"
fi

task_file="$(cd "$(dirname "$task_file")" && pwd)/$(basename "$task_file")"
"$(dirname "$0")/orch-send" "$name" "Read the task file at $task_file and execute the instructions in it."

# Log task event for activity timer
task_desc="$(head -c 200 "$task_file" | tr '\n' ' ')"
orch_log_task "TASK" "$task_desc"

echo "task sent to worker '$name' via $(basename "$task_file")"
