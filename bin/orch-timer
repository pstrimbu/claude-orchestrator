#!/usr/bin/env bash
# orch-timer — Activity-based time tracking daemon
# Usage: orch-timer start | stop | status | _daemon
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

POLL_INTERVAL=10
FLUSH_THRESHOLD=1800   # 30 minutes
IDLE_TIMEOUT=300       # 5 minutes (30 missed polls)

clockify_dir="$(orch_clockify_dir)"
pid_file="$clockify_dir/timer.pid"
accumulated_file="$clockify_dir/accumulated"
last_activity_file="$clockify_dir/last_activity"

_format_duration() {
    local secs="$1"
    local h=$((secs / 3600))
    local m=$(( (secs % 3600) / 60 ))
    local s=$((secs % 60))
    if (( h > 0 )); then
        printf "%dh%02dm" "$h" "$m"
    elif (( m > 0 )); then
        printf "%dm%02ds" "$m" "$s"
    else
        printf "%ds" "$s"
    fi
}

_update_window_title() {
    local acc="${1:-0}"
    local formatted
    formatted="$(_format_duration "$acc")"
    # Green dot (●) if timer is running
    orch_tmux set-option -t "$ORCH_SESSION" set-titles-string "$ORCH_PROJECT_ID ● $formatted" 2>/dev/null || true
}

_is_running() {
    if [[ -f "$pid_file" ]]; then
        local pid
        pid="$(cat "$pid_file")"
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        # Stale PID file
        rm -f "$pid_file"
    fi
    return 1
}

_daemon() {
    local idle_polls=0

    # Initialize accumulated if missing
    [[ -f "$accumulated_file" ]] || echo "0" > "$accumulated_file"

    # Trap SIGTERM for clean shutdown
    trap '_flush_and_exit' TERM INT

    while true; do
        sleep "$POLL_INTERVAL"

        # Check if tmux session still exists
        if ! orch_session_exists; then
            _flush_and_exit "session-gone"
            return
        fi

        # Read current window_activity
        local current_activity
        current_activity="$(orch_tmux display-message -t "$ORCH_SESSION" -p '#{window_activity}' 2>/dev/null)" || {
            _flush_and_exit "tmux-error"
            return
        }

        local last_activity="0"
        [[ -f "$last_activity_file" ]] && last_activity="$(cat "$last_activity_file")"

        if [[ "$current_activity" != "$last_activity" ]]; then
            # Activity detected — accumulate time
            echo "$current_activity" > "$last_activity_file"
            idle_polls=0

            local acc
            acc="$(cat "$accumulated_file")"
            acc=$((acc + POLL_INTERVAL))
            echo "$acc" > "$accumulated_file"

            # Update window title with accumulated time
            _update_window_title "$acc"

            # Check flush threshold
            if (( acc >= FLUSH_THRESHOLD )); then
                "$ORCH_HOME/bin/orch-flush" --reason threshold 2>/dev/null || true
            fi
        else
            # No activity
            idle_polls=$((idle_polls + 1))
            local idle_secs=$((idle_polls * POLL_INTERVAL))

            if (( idle_secs >= IDLE_TIMEOUT )); then
                local acc
                acc="$(cat "$accumulated_file")"
                if (( acc > 0 )); then
                    "$ORCH_HOME/bin/orch-flush" --reason inactivity 2>/dev/null || true
                    idle_polls=0
                fi
            fi
        fi
    done
}

_flush_and_exit() {
    local reason="${1:-exit}"
    local acc=0
    [[ -f "$accumulated_file" ]] && acc="$(cat "$accumulated_file")"
    if (( acc > 0 )); then
        "$ORCH_HOME/bin/orch-flush" --reason "$reason" 2>/dev/null || true
    fi
    # Reset window title (remove timer)
    orch_tmux set-option -t "$ORCH_SESSION" set-titles-string "$ORCH_PROJECT_ID" 2>/dev/null || true
    rm -f "$pid_file"
    exit 0
}

action="${1:-status}"

case "$action" in
    start)
        if _is_running; then
            echo "timer already running (pid $(cat "$pid_file"))"
            exit 0
        fi

        # Initialize state files
        [[ -f "$accumulated_file" ]] || echo "0" > "$accumulated_file"

        # Fork daemon
        "$0" _daemon &
        disown
        daemon_pid=$!
        echo "$daemon_pid" > "$pid_file"
        echo "timer started (pid $daemon_pid)"
        ;;

    stop)
        if ! _is_running; then
            echo "timer not running"
            exit 0
        fi

        pid="$(cat "$pid_file")"
        kill "$pid" 2>/dev/null || true

        # Wait briefly for flush
        for i in $(seq 1 10); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.5
        done

        # Clean up if still around
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
            # Manual flush since daemon didn't get to
            acc=0
            [[ -f "$accumulated_file" ]] && acc="$(cat "$accumulated_file")"
            if (( acc > 0 )); then
                "$ORCH_HOME/bin/orch-flush" --reason exit 2>/dev/null || true
            fi
        fi

        rm -f "$pid_file"
        # Reset window title
        orch_tmux set-option -t "$ORCH_SESSION" set-titles-string "$ORCH_PROJECT_ID" 2>/dev/null || true
        echo "timer stopped"
        ;;

    status)
        if _is_running; then
            acc=0
            [[ -f "$accumulated_file" ]] && acc="$(cat "$accumulated_file")"
            formatted="$(_format_duration "$acc")"

            task_count=0
            tasks_file="$clockify_dir/tasks.log"
            [[ -f "$tasks_file" ]] && task_count="$(wc -l < "$tasks_file" | tr -d ' ')"

            echo "timer: running (pid $(cat "$pid_file"))"
            echo "accumulated: $formatted ($acc seconds)"
            echo "tasks logged: $task_count"
        else
            echo "timer: not running"
            acc=0
            [[ -f "$accumulated_file" ]] && acc="$(cat "$accumulated_file")"
            if (( acc > 0 )); then
                echo "unflushed: $(_format_duration "$acc") ($acc seconds)"
            fi
        fi
        ;;

    _daemon)
        _daemon
        ;;

    *)
        echo "usage: orch-timer start | stop | status" >&2
        exit 1
        ;;
esac
