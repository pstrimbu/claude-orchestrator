#!/usr/bin/env bash
# orch-create — Create a new worker session running Claude Code
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

name="$(orch_resolve_name "${1:-}")"
workdir="${2:-.}"

orch_validate_name "$name"

if orch_session_exists "$name"; then
    orch_die "session $(orch_session_name "$name") already exists"
fi

if [[ ! -d "$workdir" ]]; then
    orch_die "directory does not exist: $workdir"
fi

session="$(orch_session_name "$name")"
workdir="$(cd "$workdir" && pwd)"
mkdir -p "$(dirname "$ORCH_TMUX_SOCK")"
orch_tmux new-session -d -s "$session" -c "$workdir"
orch_tmux send-keys -t "$session" "claude --dangerously-skip-permissions" Enter
sleep 3

# Log worker creation
state_dir="$(orch_state_dir)"
echo "{\"name\":\"$name\",\"session\":\"$session\",\"workdir\":\"$workdir\",\"created\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"status\":\"active\"}" >> "$state_dir/workers.jsonl"

echo "created $session"
