#!/usr/bin/env bash
# orch-create — Create a new worker pane in the orchestrator window
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

name="$(orch_resolve_name "${1:-}")"
orch_validate_name "$name"

if ! orch_session_exists; then
    orch_die "orchestrator session not running — run 'orch' first"
fi

if orch_worker_exists "$name"; then
    orch_die "worker '$name' already exists"
fi

# Split from the orchestrator's window, capture new pane ID
pane_id="$(orch_tmux split-window -t "$ORCH_SESSION" -h -P -F '#{pane_id}' -c "$(pwd -P)")"

# Apply main-vertical layout: orchestrator on left, workers stacked on right
orch_relayout

# Start claude in the new pane
orch_tmux send-keys -t "$pane_id" "claude --dangerously-skip-permissions" Enter

# Store pane ID
pane_dir="$(orch_pane_dir)"
echo "$pane_id" > "$pane_dir/$name"

sleep 3

# Log
state_dir="$(orch_state_dir)"
echo "{\"name\":\"$name\",\"pane\":\"$pane_id\",\"created\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"status\":\"active\"}" >> "$state_dir/workers.jsonl"

echo "created worker '$name' (pane $pane_id)"
