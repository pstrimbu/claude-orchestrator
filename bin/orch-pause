#!/usr/bin/env bash
# orch-pause — Send Escape to one or all workers to interrupt Claude
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

if [[ "${1:-}" == "--all" ]]; then
    pane_dir="$(orch_pane_dir)"
    for pane_file in "$pane_dir"/*; do
        [[ -f "$pane_file" ]] || continue
        name="$(basename "$pane_file")"
        if orch_worker_exists "$name"; then
            pane_id="$(orch_worker_pane "$name")"
            orch_tmux send-keys -t "$pane_id" Escape
            echo "paused $name"
        fi
    done
else
    name="$(orch_resolve_name "${1:-}")"
    orch_validate_name "$name"
    pane_id="$(orch_worker_pane "$name")"
    if [[ -z "$pane_id" ]]; then
        orch_die "worker '$name' does not exist"
    fi
    orch_tmux send-keys -t "$pane_id" Escape
    echo "paused $name"
fi
