#!/usr/bin/env bash
# orch-tracker — Unified entry point for issue tracker operations.
# Routes to orch-linear or orch-jira based on tracker.type in project config.
# Also provides the 'doctor' preflight command.
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

# --- doctor command: preflight validation ---
if [[ "${1:-}" == "doctor" ]]; then
    errors=0
    warnings=0

    echo "=== orch-tracker doctor ==="
    echo ""

    # 1. Tracker type
    tracker_type="$(orch_tracker_type)"
    echo "Tracker type: $tracker_type"

    if [[ "$tracker_type" == "none" ]]; then
        echo ""
        echo "No tracker configured."
        echo "To enable, set tracker.type in .orch/project.json to 'linear' or 'jira'."
        exit 0
    fi

    # 2. Config validation
    echo ""
    echo "--- Config ---"
    config_path="$(orch_project_config_path)"
    if [[ -f "$config_path" ]]; then
        echo "Config file: $config_path (exists)"
    else
        echo "FAIL: Config file $config_path not found"
        errors=$((errors + 1))
    fi

    team_key="$(orch_tracker_team_key)"
    if [[ -n "$team_key" ]]; then
        echo "Project/Team key: $team_key"
    else
        echo "FAIL: No project/team key configured"
        errors=$((errors + 1))
    fi

    title_prefix="$(orch_tracker_title_prefix)"
    echo "Title prefix: $title_prefix"

    # 3. Auth env var validation
    echo ""
    echo "--- Auth ---"

    if [[ "$tracker_type" == "linear" ]]; then
        api_key_env="$(orch_project_config_get 'linear.auth.api_key_env')"
        api_key_env="${api_key_env:-LINEAR_API_KEY}"
        _val="${!api_key_env:-}"
        if [[ -n "$_val" ]]; then
            echo "$api_key_env: set (${#_val} chars)"
        else
            echo "FAIL: $api_key_env is not set"
            errors=$((errors + 1))
        fi
    elif [[ "$tracker_type" == "jira" ]]; then
        base_url_env="$(orch_project_config_get 'jira.auth.base_url_env')"
        base_url_env="${base_url_env:-JIRA_BASE_URL}"
        email_env="$(orch_project_config_get 'jira.auth.email_env')"
        email_env="${email_env:-JIRA_EMAIL}"
        token_env="$(orch_project_config_get 'jira.auth.api_token_env')"
        token_env="${token_env:-JIRA_API_TOKEN}"

        for env_name in "$base_url_env" "$email_env" "$token_env"; do
            if [[ -n "${!env_name:-}" ]]; then
                echo "$env_name: set"
            else
                echo "FAIL: $env_name is not set"
                errors=$((errors + 1))
            fi
        done
    fi

    # 4. API connectivity
    echo ""
    echo "--- API ---"
    if [[ $errors -eq 0 ]]; then
        viewer_rc=0
        viewer_output="$("$ORCH_HOME/bin/orch-$tracker_type" viewer 2>&1)" || viewer_rc=$?
        if [[ $viewer_rc -eq 0 ]]; then
            echo "Viewer: OK"
            echo "$viewer_output" | head -5
        else
            echo "FAIL: viewer command failed"
            echo "$viewer_output" | head -3
            errors=$((errors + 1))
        fi

        # Tracker-specific validation
        if [[ "$tracker_type" == "linear" && -n "$team_key" && $viewer_rc -eq 0 ]]; then
            # Validate team key resolves (uses orch-linear internals via python)
            team_check_rc=0
            python3 -c "
import json, os, urllib.request
env = '$(orch_project_config_get 'linear.auth.api_key_env')'
env = env or 'LINEAR_API_KEY'
key = os.environ.get(env, '')
req = urllib.request.Request('https://api.linear.app/graphql',
    data=json.dumps({'query': 'query(\$k:String!){teams(filter:{key:{eq:\$k}}){nodes{id name}}}', 'variables': {'k': '$team_key'}}).encode(),
    headers={'Authorization': key, 'Content-Type': 'application/json'})
resp = json.loads(urllib.request.urlopen(req).read())
nodes = resp.get('data',{}).get('teams',{}).get('nodes',[])
if nodes:
    print(f\"Team '{nodes[0]['name']}' ({nodes[0]['id']}): OK\")
else:
    print('FAIL: team key not found')
    exit(1)
" 2>/dev/null || team_check_rc=$?
            if [[ $team_check_rc -ne 0 ]]; then
                echo "FAIL: Linear team '$team_key' not found"
                errors=$((errors + 1))
            fi
        elif [[ "$tracker_type" == "jira" && -n "$team_key" && $viewer_rc -eq 0 ]]; then
            project_check_rc=0
            "$ORCH_HOME/bin/orch-jira" --force <<< "" 2>/dev/null || true
            # Use python to check project exists
            python3 -c "
import json, os, base64, urllib.request
base_env = '$(orch_project_config_get 'jira.auth.base_url_env')' or 'JIRA_BASE_URL'
email_env = '$(orch_project_config_get 'jira.auth.email_env')' or 'JIRA_EMAIL'
token_env = '$(orch_project_config_get 'jira.auth.api_token_env')' or 'JIRA_API_TOKEN'
base = os.environ.get(base_env,'').rstrip('/')
email = os.environ.get(email_env,'')
token = os.environ.get(token_env,'')
creds = base64.b64encode(f'{email}:{token}'.encode()).decode()
req = urllib.request.Request(f'{base}/rest/api/3/project/$team_key',
    headers={'Authorization': f'Basic {creds}', 'Accept': 'application/json'})
try:
    resp = json.loads(urllib.request.urlopen(req).read())
    print(f\"Project '{resp.get('name','')}' ({resp.get('key','')}): OK\")
except urllib.error.HTTPError as e:
    print(f'FAIL: Jira project $team_key not found ({e.code})')
    exit(1)
" 2>/dev/null || project_check_rc=$?
            if [[ ${project_check_rc:-0} -ne 0 ]]; then
                echo "FAIL: Jira project '$team_key' not found"
                errors=$((errors + 1))
            fi
        fi
    else
        echo "SKIP: fix auth errors above first"
    fi

    # Summary
    echo ""
    echo "=== Result: $errors errors ==="
    [[ $errors -eq 0 ]]
    exit $?
fi

# --- Normal routing ---
tracker_type="$(orch_tracker_type)"

case "$tracker_type" in
    linear)
        exec "$ORCH_HOME/bin/orch-linear" "$@"
        ;;
    jira)
        exec "$ORCH_HOME/bin/orch-jira" "$@"
        ;;
    none)
        echo "error: no tracker configured. Set tracker.type in .orch/project.json" >&2
        echo "  Supported types: linear, jira" >&2
        exit 1
        ;;
    *)
        echo "error: unknown tracker type '$tracker_type'. Supported: linear, jira" >&2
        exit 1
        ;;
esac
