#!/usr/bin/env bash
# orch-clean — reclaim disk from regenerable build artifacts across ~/dev.
#
# Everything here can be rebuilt from source. What differs between tiers is the
# COST of rebuilding, and the chance a rebuild does not reproduce what was
# deleted — so each tier gates on different evidence:
#
#   1 cache    .turbo/cache, .next/dev, .next/cache, .pytest_cache, .ruff_cache
#              Scratch. Regenerated by the next build or dev server with no input
#              from anyone. Cleared for every project, running or not.
#
#   2 build    .next, dist, target, .turbo
#              Real build output. Costs a rebuild, so it is skipped where a
#              session is live or the tree is dirty — a slow rebuild in the
#              middle of something is the whole cost of this landing badly.
#
#   3 deps     node_modules, .venv
#              Reinstallable only while the lockfile still resolves. A yanked
#              package, an expired private-registry token, a native module built
#              against a toolchain since upgraded, or hand-patched files never
#              committed all turn "reinstall" into "afternoon". Needs an idle
#              project, a clean tree AND a committed lockfile.
#
# The counterintuitive part, and why tier 3 is gated hardest: the SAFEST
# deletions are in the projects worked on this week, and the riskiest are in the
# ones untouched for months — exactly what an "old projects" sweep would target.
# Dormant projects are also the likeliest to be sitting dirty, mid-thought.
#
# Dry run unless --apply. Nothing is deleted without being printed first, and
# every path is re-validated at the moment of deletion (see safe_delete) rather
# than trusted from the scan.

set -uo pipefail

ROOT="${ORCH_CLEAN_ROOT:-$HOME/dev}"
STATE_DIR="${ORCH_STATE_DIR:-.orch}"
APPLY=0
TIERS="1"
IDLE_DAYS=30
MIN_MB=10
ONLY=""

# The only directory names this tool may ever remove. safe_delete refuses
# anything whose basename is not on this list, so a malformed path from the scan
# cannot become an unbounded delete.
DELETABLE=(".turbo" "cache" "dev" ".next" ".pytest_cache" ".ruff_cache"
           ".mypy_cache" "dist" "target" "node_modules" ".venv")

usage() {
    cat <<'USAGE'
orch-clean — reclaim disk from regenerable build artifacts

  orch-clean [--tier 1|2|3|all] [--apply] [options]

  --tier N       1=cache (default, always safe)  2=+build output  3=+dependencies
                 Cumulative: --tier 3 includes 1 and 2.
  --apply        actually delete (default is a dry run)
  --idle DAYS    a project counts as idle after this many days with no commit (default 30)
  --min MB       ignore anything smaller (default 10)
  --only NAME    restrict to one project directory name
  --root DIR     where the projects live (default ~/dev)
  -h, --help     this

Examples
  orch-clean                          # what tier 1 would free, everywhere
  orch-clean --tier 3                 # the full picture, still a dry run
  orch-clean --apply                  # free the safe stuff now
  orch-clean --only myproject.example.com --tier 2 --apply
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --tier)   TIERS="${2:-}"; shift 2 ;;
        --apply)  APPLY=1; shift ;;
        --idle)   IDLE_DAYS="${2:-}"; shift 2 ;;
        --min)    MIN_MB="${2:-}"; shift 2 ;;
        --only)   ONLY="${2:-}"; shift 2 ;;
        --root)   ROOT="${2:-}"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "orch-clean: unknown option '$1'" >&2; usage >&2; exit 2 ;;
    esac
done

case "$TIERS" in
    1|2|3) MAX_TIER="$TIERS" ;;
    all)   MAX_TIER=3 ;;
    *) echo "orch-clean: --tier must be 1, 2, 3 or all" >&2; exit 2 ;;
esac
[[ "$IDLE_DAYS" =~ ^[0-9]+$ ]] || { echo "orch-clean: --idle must be a number" >&2; exit 2; }
[[ "$MIN_MB"    =~ ^[0-9]+$ ]] || { echo "orch-clean: --min must be a number" >&2; exit 2; }

# Resolve and sanity-check the root before anything walks it. A root of "/" or
# the home directory itself would put every rule below one typo away from a very
# bad afternoon.
ROOT="$(cd "$ROOT" 2>/dev/null && pwd -P)" || { echo "orch-clean: no such directory" >&2; exit 1; }
case "$ROOT" in
    "/"|"$HOME"|"") echo "orch-clean: refusing to operate on '$ROOT'" >&2; exit 1 ;;
esac
[[ "$(printf '%s' "$ROOT" | tr -cd '/' | wc -c)" -ge 2 ]] || {
    echo "orch-clean: refusing a root this shallow: $ROOT" >&2; exit 1; }

if [[ -t 1 ]]; then
    B=$'\033[1m'; DIM=$'\033[2m'; GRN=$'\033[32m'; YEL=$'\033[33m'; RED=$'\033[31m'; RST=$'\033[0m'
else
    B=""; DIM=""; GRN=""; YEL=""; RED=""; RST=""
fi

# --- project state ---------------------------------------------------------

# A live orch session. Trusts the pid file only when it points at a real
# process, mirroring SystemUtils.getRunningPid on the launcher side.
session_running() {
    local pidfile="$1/$STATE_DIR/orch.pid" pid
    [[ -f "$pidfile" ]] || return 1
    pid="$(tr -d '[:space:]' < "$pidfile" 2>/dev/null)"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null
}

# Uncommitted work. A non-repo is reported separately (state "norepo") rather
# than lumped in as dirty: both are held back, but "uncommitted changes" on a
# directory with no git at all sends you hunting for changes that do not exist.
project_state() {   # -> clean | dirty | norepo
    [[ -d "$1/.git" ]] || { echo norepo; return; }
    if [[ -n "$(git -C "$1" status --porcelain 2>/dev/null | head -1)" ]]; then
        echo dirty
    else
        echo clean
    fi
}

idle_days() {
    local last
    last="$(git -C "$1" log -1 --format=%ct 2>/dev/null)"
    [[ -n "$last" ]] || { echo 99999; return; }
    echo $(( ( $(date +%s) - last ) / 86400 ))
}

# A lockfile the dependency tree can actually be rebuilt from — COMMITTED, not
# merely present. An untracked lockfile vanishes with the next clone.
has_committed_lock() {
    local dir="$1" f hit
    [[ -d "$dir/.git" ]] || return 1
    for f in pnpm-lock.yaml package-lock.json yarn.lock bun.lockb \
             poetry.lock uv.lock requirements.txt Pipfile.lock; do
        git -C "$dir" ls-files --error-unmatch "$f" >/dev/null 2>&1 && return 0
        while IFS= read -r hit; do
            [[ -n "$hit" ]] && return 0
        done < <(git -C "$dir" ls-files -- "*/$f" 2>/dev/null | head -1)
    done
    return 1
}

size_kb() { du -sk "$1" 2>/dev/null | cut -f1; }

human() {
    awk -v k="${1:-0}" 'BEGIN{
        if (k >= 1048576) printf "%.1fG", k/1048576;
        else if (k >= 1024) printf "%dM", k/1024;
        else printf "%dK", k
    }'
}

# Delete one artifact directory, re-checking at the moment of removal rather
# than trusting the path collected during the scan. Every condition here has to
# hold: a real directory, not a symlink, strictly inside ROOT, deeper than the
# project level, and named as something this tool is allowed to remove.
safe_delete() {
    local path="$1" base ok=1 name
    [[ -n "$path" && -d "$path" && ! -L "$path" ]] || return 1
    [[ "$path" == "$ROOT"/*/* ]] || return 1
    case "$path" in *".."*) return 1 ;; esac
    base="$(basename "$path")"
    for name in "${DELETABLE[@]}"; do
        [[ "$base" == "$name" ]] && { ok=0; break; }
    done
    (( ok == 0 )) || return 1
    rm -rf -- "$path"
}

# --- the sweep -------------------------------------------------------------

TOTAL_KB=0; TOTAL_N=0; SKIPPED=""
declare -a DOOMED=()

collect() {  # collect <dir> <tier-label>
    local d="$1" label="$2" kb
    kb="$(size_kb "$d")"; [[ "$kb" =~ ^[0-9]+$ ]] || return
    (( kb < MIN_MB * 1024 )) && return
    DOOMED+=("$kb|$label|$d")
    TOTAL_KB=$(( TOTAL_KB + kb )); TOTAL_N=$(( TOTAL_N + 1 ))
}

for proj in "$ROOT"/*/; do
    proj="${proj%/}"
    [[ -d "$proj" && ! -L "$proj" ]] || continue
    name="$(basename "$proj")"
    [[ -n "$ONLY" && "$name" != "$ONLY" ]] && continue

    running=0; session_running "$proj" && running=1
    state="$(project_state "$proj")"
    dirty=0; [[ "$state" != "clean" ]] && dirty=1
    case "$state" in
        dirty)  why="uncommitted changes" ;;
        norepo) why="not a git repository" ;;
        *)      why="" ;;
    esac
    idle="$(idle_days "$proj")"

    # Tier 1 — scratch. Safe even under a live session: a dev server that loses
    # its cache recompiles, which it does on any edit anyway.
    while IFS= read -r d; do
        [[ -n "$d" ]] && collect "$d" "cache"
    done < <(find "$proj" -maxdepth 5 \
                \( -path "*/.turbo/cache" -o -path "*/.next/dev" -o -path "*/.next/cache" \
                   -o -name ".pytest_cache" -o -name ".ruff_cache" -o -name ".mypy_cache" \) \
                -type d -prune 2>/dev/null | grep -v "/node_modules/")

    if (( MAX_TIER >= 2 )); then
        if (( running )); then
            SKIPPED+="  ${DIM}${name}${RST} — session running, build output left alone"$'\n'
        elif (( dirty )); then
            SKIPPED+="  ${DIM}${name}${RST} — ${why}, build output left alone"$'\n'
        else
            while IFS= read -r d; do
                [[ -n "$d" ]] && collect "$d" "build"
            done < <(find "$proj" -maxdepth 4 \
                        \( -name ".next" -o -name "dist" -o -name "target" -o -name ".turbo" \) \
                        -type d -prune 2>/dev/null | grep -v "/node_modules/")
        fi
    fi

    if (( MAX_TIER >= 3 )); then
        if (( running )); then
            :
        elif (( idle < IDLE_DAYS )); then
            SKIPPED+="  ${DIM}${name}${RST} — active (${idle}d), dependencies left alone"$'\n'
        elif (( dirty )); then
            SKIPPED+="  ${DIM}${name}${RST} — ${YEL}${why}${RST}, dependencies left alone"$'\n'
        elif ! has_committed_lock "$proj"; then
            SKIPPED+="  ${DIM}${name}${RST} — ${YEL}no committed lockfile${RST}, dependencies not reinstallable"$'\n'
        else
            while IFS= read -r d; do
                [[ -n "$d" ]] && collect "$d" "deps"
            done < <(find "$proj" -maxdepth 4 \
                        \( -name "node_modules" -o -name ".venv" \) -type d -prune 2>/dev/null)
        fi
    fi
done

# --- report ----------------------------------------------------------------

if (( TOTAL_N == 0 )); then
    echo "orch-clean: nothing to reclaim at tier $TIERS (min ${MIN_MB}MB)."
    [[ -n "$SKIPPED" ]] && { echo; echo "Held back:"; printf "%b" "$SKIPPED"; }
    exit 0
fi

printf '%b\n' "${B}$( (( APPLY )) && echo "Deleting" || echo "Would delete" ) ${TOTAL_N} directories — $(human "$TOTAL_KB")${RST}"
echo
printf "%-8s %-7s %s\n" "SIZE" "TIER" "PATH"
printf '%s\n' "----------------------------------------------------------------------------"
while IFS= read -r row; do
    kb="${row%%|*}"; rest="${row#*|}"; tier="${rest%%|*}"; path="${rest#*|}"
    printf "%-8s %-7s %s\n" "$(human "$kb")" "$tier" "${path#"$ROOT"/}"
done < <(printf '%s\n' "${DOOMED[@]}" | sort -t'|' -k1 -rn)

if [[ -n "$SKIPPED" ]]; then
    echo; printf '%b\n' "${B}Held back${RST}"; printf "%b" "$SKIPPED"
fi

if (( ! APPLY )); then
    echo
    printf '%b\n' "${DIM}Dry run. Re-run with --apply to delete.${RST}"
    exit 0
fi

echo
failed=0; freed_kb=0
for row in "${DOOMED[@]}"; do
    kb="${row%%|*}"; rest="${row#*|}"; path="${rest#*|}"
    if safe_delete "$path"; then
        freed_kb=$(( freed_kb + kb ))
    else
        printf '%b\n' "${RED}refused or failed:${RST} $path"
        failed=$(( failed + 1 ))
    fi
done

printf '%b\n' "${GRN}Freed $(human "$freed_kb")${RST}$( (( failed )) && echo " — ${failed} refused or failed" )"
(( failed == 0 ))
