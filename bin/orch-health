#!/usr/bin/env bash
# orch-health — Check a single worker's health
# Exit codes: 0=healthy, 1=dead, 2=stuck
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

name="$(orch_resolve_name "${1:-}")"
orch_validate_name "$name"

pane_ok="no"
claude_ok="no"
stuck="no"

if orch_worker_exists "$name"; then
    pane_ok="yes"
    if orch_claude_running "$name"; then
        claude_ok="yes"
    fi
    # Check for context limit stuck state
    pane_id="$(orch_worker_pane "$name")"
    if [[ -n "$pane_id" ]] && orch_pane_stuck "$pane_id"; then
        stuck="yes"
    fi
fi

echo "$name pane=$pane_ok claude=$claude_ok stuck=$stuck"

if [[ "$stuck" == "yes" ]]; then
    exit 2
elif [[ "$pane_ok" == "yes" && "$claude_ok" == "yes" ]]; then
    exit 0
else
    exit 1
fi
