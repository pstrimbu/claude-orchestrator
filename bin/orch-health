#!/usr/bin/env bash
# orch-health — Check a single worker's health
set -euo pipefail
source "$(dirname "$0")/orch-lib.sh"

name="$(orch_resolve_name "${1:-}")"
orch_validate_name "$name"

session="$(orch_session_name "$name")"
session_ok="no"
claude_ok="no"

if orch_session_exists "$name"; then
    session_ok="yes"
    if orch_claude_running "$name"; then
        claude_ok="yes"
    fi
fi

echo "$session session=$session_ok claude=$claude_ok"

if [[ "$session_ok" == "yes" && "$claude_ok" == "yes" ]]; then
    exit 0
else
    exit 1
fi
