# Orchestrator tracker credentials
# Copy to .env and fill in values. NEVER commit .env with secrets.

# --- Clockify time tracking (optional) ---
# All three are required, or time tracking stays off. Find the workspace and
# user IDs with:
#   curl -H "X-Api-Key: $CLOCKIFY_API_KEY" https://api.clockify.me/api/v1/user
# -> "activeWorkspace" is the workspace id, "id" is the user id.
CLOCKIFY_API_KEY=
CLOCKIFY_WORKSPACE_ID=
CLOCKIFY_USER_ID=

# --- Linear (when tracker.type=linear) ---
LINEAR_API_KEY=lin_api_...

# --- Jira (when tracker.type=jira) ---
JIRA_BASE_URL=https://mycompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-api-token-here

# --- Per-project overrides ---
# If you use jira.auth.base_url_env / jira.auth.email_env / jira.auth.api_token_env
# in .orch/project.json, define those custom env var names here instead:
# MYPROJ_JIRA_URL=https://mycompany.atlassian.net
# MYPROJ_JIRA_EMAIL=you@company.com
# MYPROJ_JIRA_TOKEN=your-api-token-here
